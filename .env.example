# ── Brevo SMTP (free: 300 emails/day) ─────────────────────────────────
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# Get these from: Brevo dashboard → Transactional (SMTP & API) → SMTP
#   MAIL_HOST = smtp-relay.brevo.com   (port 587)  or  smtp.brevo.com (465)
#   MAIL_USER = your Brevo account email
#   MAIL_PASS = your SMTP KEY (NOT your Brevo account password)
#
# Note: MAIL_PASS must be an SMTP key you generate inside Brevo, and the
# sender address must be verified first (Brevo → Senders → Add sender).

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=you@example.com
MAIL_PASS=your-brevo-smtp-key-here
MAIL_FROM=you@example.com
MAIL_STARTTLS=1

# ── Chatbot → human agent handoff ──────────────────────────────────────
# POST /api/contact emails the visitor's question to this address, then the
# agent replies straight back (the visitor's address arrives in Reply-To).
# Optional: leave it out and the handoff falls back to MAIL_FROM, so the
# feature works with nothing new to configure.
# NOTIFY_EMAIL=you@example.com
