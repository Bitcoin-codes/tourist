.DS_Store

# Gallery pipeline state — the search checkpoint and the Commons API cache.
# Kept in the repository so a reboot cannot throw away weeks of rate-limited
# searching, and ignored so it never ships: it is this machine's progress, and
# the cache is refetched rather than shared.
.gallery-state/

# Secrets — SMTP / Supabase / any API credentials
.env
.env.*
!.env.example

# Supabase CLI local state (contains DB connection strings)
supabase/.temp/
**/.supabase/
.vercel
.env*
# The template carries setup notes (NOTIFY_EMAIL) and no secrets — only the
# real .env stays out.
!.env.example

# Unreferenced screenshot artifact
hero-preview.png

# Written by `vercel build` while it normalizes requirements.txt for uv.
# Committed, they pin `requires-python` to whatever interpreter ran the local
# build and the next build fails on it ("resolved to 3.12.15, which is
# incompatible with ==3.14.*"); the deploy regenerates them anyway.
pyproject.toml
uv.lock
